# Settings for the EXPERIMENT lane — re-running the measurement campaign on AWS.
#
# The RESULTS lane (`make`, which redraws the paper's tables and figures from
# the committed campaign) reads none of this and needs no AWS account.
#
# Copy this file to .env and fill it in. Never commit .env.

# --- AWS testbed ---

# Region for all three instances. Keep them together: cross-region traffic adds
# uncontrolled latency to a sweep whose whole subject is latency.
AWS_REGION=eu-central-1

# Name of an EC2 key pair in AWS_REGION, for SSH to the three instances.
KEY_NAME=your-ec2-keypair-name

# Every public address you operate from, as a Terraform list. List the VPN and
# non-VPN ones both, so toggling the VPN part-way through an eleven-hour run
# cannot lock you out of it.
ALLOWED_SSH_CIDRS=["203.0.113.7/32"]

# Extra tags stamped on every resource and volume, as a JSON object. Some
# organizations run automation that stops or deletes long-running instances,
# and a multi-hour benchmark grid looks idle to one; if yours needs an
# exemption tag, or an owner tag for cost attribution, put them here.
#   EXTRA_TAGS={"owner":"your-name","keep-alive":"true"}
EXTRA_TAGS={}

# --- Dataset ---

# OPTIONAL S3 bucket caching the fetched DICOM tree. Leave empty and the
# dataset is downloaded from TCIA on every run, which is the default and needs
# no bucket, no IAM role and no credentials beyond the download itself. Set it
# and the first run uploads the tree, after which later runs restore in minutes
# instead of hours. Create it with `make backup-bucket`.
DATASET_BACKUP_BUCKET=

# Series to fetch for the campaign. The paper uses 200.
REMOTE_N_SERIES=200
